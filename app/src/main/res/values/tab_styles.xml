<?xml version="1.0" encoding="utf-8"?>
<resources>
    
    <!-- TabBar主题样式 -->
    <style name="ModernTabBarTheme">
        <item name="android:elevation">12dp</item>
        <item name="android:background">@drawable/modern_tab_background</item>
    </style>
    
    <!-- Tab按钮样式 -->
    <style name="TabButtonStyle">
        <item name="android:background">@drawable/tab_button_selector</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">8dp</item>
    </style>
    
    <!-- Tab文本样式 - 激活状态 -->
    <style name="TabTextActive">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/indigo_500</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <!-- Tab文本样式 - 非激活状态 -->
    <style name="TabTextInactive">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/colorDarkGray</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    
    <!-- Tab图标样式 -->
    <style name="TabIconStyle">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:layout_marginEnd">6dp</item>
    </style>
    
    <!-- 指示器样式 -->
    <style name="TabIndicatorStyle">
        <item name="android:layout_height">3dp</item>
        <item name="android:layout_gravity">bottom</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:background">@drawable/tab_indicator_background</item>
    </style>
    
    <!-- 夜间模式TabBar主题 -->
    <style name="ModernTabBarTheme.Night">
        <item name="android:elevation">12dp</item>
        <item name="android:background">@drawable/modern_tab_background_night</item>
    </style>
    
    <!-- 紧凑型TabBar样式 -->
    <style name="ModernTabBarTheme.Compact">
        <item name="android:elevation">8dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/modern_tab_background</item>
    </style>
    
    <!-- 大型TabBar样式 -->
    <style name="ModernTabBarTheme.Large">
        <item name="android:elevation">16dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/modern_tab_background</item>
    </style>
    
</resources>