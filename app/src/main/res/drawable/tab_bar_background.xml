<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- 圆角设置 -->
    <corners android:radius="16dp" />
    
    <!-- 背景颜色 - 使用白色以确保圆角效果可见 -->
    <solid android:color="@color/colorPrimary" />
    
    <!-- 阴影效果 -->
    <stroke
        android:width="0.5dp"
        android:color="#E0E0E0" />
        
</shape>